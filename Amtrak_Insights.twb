      <column caption='Long Distance Count' datatype='integer' name='[Calculation_181832856193245184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [routeType] = &quot;Long Distance&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='State Supported Count' datatype='integer' name='[Calculation_181832856193409025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [routeType] = &apos;State Supported&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Northeast Corridor Count' datatype='integer' name='[Calculation_181832856193482754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [routeType] = &apos;Northeast Corridor&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Avg OTP of FY 23' datatype='real' name='[Calculation_181832856196419587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [routeYear] = &apos;FY23&apos; THEN [routeOTP] END)' />
      </column>
      <column caption='RouteFrequency' datatype='string' name='[Calculation_356347338824957952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([routeFrequency]),&apos;No Value&apos;)' />
      </column>
      <column caption='Host Railroad Group' datatype='string' name='[Calculation_356347338828075009]' role='dimension' type='nominal'>
