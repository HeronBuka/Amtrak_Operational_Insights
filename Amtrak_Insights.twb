    <worksheet name='TOP 10 staions(Budget)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Which are the top 10 stations with the highest total budget, and what is the average On-Time Performance (OTP) of the routes that serve these stations?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='OnTrack.Station+ (BUDT703_Project_0506_06)' name='federated.07qf71c0obnvob10lkpon05cxk8n' />
          </datasources>
          <datasource-dependencies datasource='federated.07qf71c0obnvob10lkpon05cxk8n'>
            <column caption='Ranked Stations(by total budget)' datatype='integer' name='[Calculation_710442859363975186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([budgetAllocation]),&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[routeOTP]' derivation='Avg' name='[avg:routeOTP:qk]' pivot='key' type='quantitative' />
            <column caption='Budget Allocation' datatype='real' name='[budgetAllocation]' role='measure' type='quantitative' />
            <column caption='Budget Total' datatype='real' name='[budgetTotal]' role='measure' type='quantitative' />
            <column-instance column='[stationCode]' derivation='None' name='[none:stationCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[stationName]' derivation='None' name='[none:stationName:nk]' pivot='key' type='nominal' />
            <column caption='Route OTP' datatype='real' name='[routeOTP]' role='measure' type='quantitative' />
            <column caption='Station Code' datatype='string' name='[stationCode]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Station Name' datatype='string' name='[stationName]' role='dimension' type='nominal' />
            <column-instance column='[budgetTotal]' derivation='Sum' name='[sum:budgetTotal:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_710442859363975186]' derivation='User' name='[usr:Calculation_710442859363975186:qk:6]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Field'>
                <order field='[federated.07qf71c0obnvob10lkpon05cxk8n].[none:stationCode:nk]' />
                <order field='[federated.07qf71c0obnvob10lkpon05cxk8n].[none:stationName:nk]' />
              </table-calc>
            </column-instance>
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.07qf71c0obnvob10lkpon05cxk8n].[usr:Calculation_710442859363975186:qk:6]' included-values='in-range'>
            <min>1</min>
            <max>10</max>
          </filter>
          <slices>
            <column>[federated.07qf71c0obnvob10lkpon05cxk8n].[usr:Calculation_710442859363975186:qk:6]</column>
          </slices>
