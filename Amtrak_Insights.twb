            <run fontsize='12'>How can we calculate the FY23 average on-time performance (Average OTP FY23) for different route types (Long Distance, State Supported, Northeast Corridor) grouped by state?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='OnTrack.Station+ (BUDT703_Project_0506_06)' name='federated.07qf71c0obnvob10lkpon05cxk8n' />
          </datasources>
          <datasource-dependencies datasource='federated.07qf71c0obnvob10lkpon05cxk8n'>
            <column caption='Avg OTP of FY23' datatype='real' name='[Calculation_622341194884161539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [routeYear] = &apos;FY23&apos; THEN [routeOTP] END)' />
            </column>
            <column-instance column='[routeType]' derivation='Count' name='[cnt:routeType:qk]' pivot='key' type='quantitative' />
            <column-instance column='[routeType]' derivation='None' name='[none:routeType:nk]' pivot='key' type='nominal' />
            <column-instance column='[stationState]' derivation='None' name='[none:stationState:nk]' pivot='key' type='nominal' />
            <column caption='Route OTP' datatype='real' name='[routeOTP]' role='measure' type='quantitative' />
            <column caption='Route Type' datatype='string' name='[routeType]' role='dimension' type='nominal' />
            <column caption='Route Year' datatype='string' name='[routeYear]' role='dimension' type='nominal' />
            <column caption='Station State' datatype='string' name='[stationState]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_622341194884161539]' derivation='User' name='[usr:Calculation_622341194884161539:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07qf71c0obnvob10lkpon05cxk8n].[none:stationState:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:stationState:nk]' />
              <groupfilter function='member' level='[none:stationState:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.07qf71c0obnvob10lkpon05cxk8n].[none:stationState:nk]</column>
          </slices>
          <aggregation value='true' />
