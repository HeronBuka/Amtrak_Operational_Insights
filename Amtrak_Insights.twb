          <datasource-dependencies datasource='federated.07qf71c0obnvob10lkpon05cxk8n'>
            <column caption='Allocation Per Rider' datatype='real' name='[Calculation_710442859357626379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([budgetTotal])/SUM([ridershipQuantity])' />
