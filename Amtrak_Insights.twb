      <column caption='Ranked Station(by routes)' datatype='integer' name='[Calculation_622341194871242752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(COUNT([routeId]),&apos;DESC&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg OTP of FY23' datatype='real' name='[Calculation_622341194884161539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [routeYear] = &apos;FY23&apos; THEN [routeOTP] END)' />
      </column>
      <column caption='Allocation Per Rider' datatype='real' name='[Calculation_710442859357626379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([budgetTotal])/SUM([ridershipQuantity])' />
      </column>
      <column caption='Total Riderships' datatype='integer' name='[Calculation_710442859358167055]' role='measure' type='quantitative'>
