            <column caption='Ranked Stations(by riderships)' datatype='integer' name='[Calculation_710442859397177363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([ridershipQuantity]))'>
                <table-calc ordering-type='Rows' />
